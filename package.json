{
  "name": "satoyama-evening",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/world.test.mjs",
    "assets": "python tools/generate_world.py && python tools/generate_foliage.py && python tools/generate_audio.py && node tools/build-models.mjs && node tools/build-trees.mjs && node tools/generate-canopy.mjs && python tools/catalog-assets.py",
    "test:browser": "playwright test",
    "build:pages": "tsc --noEmit && vite build --base=/shrine/"
  },
  "dependencies": {
    "three": "^0.180.0",
    "@dimforge/rapier3d-compat": "^0.19.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "@playwright/test": "^1.56.1"
  }
}
